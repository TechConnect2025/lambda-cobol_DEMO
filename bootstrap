#!/bin/sh

set -euo pipefail

# Java Lambda handler bootstrap script
# This script implements the Lambda Runtime API for invoking a Java handler

HANDLER_CLASSPATH="/var/task/lambda-java-hello.jar"
export CLASSPATH="$HANDLER_CLASSPATH"

# Processing Loop - continuously poll for Lambda events
while true
do
  echo "Handler: ${_HANDLER}"
  HEADERS="$(mktemp)"
  
  # Get an event from the Lambda Runtime API
  # The HTTP request will block until one is received
  EVENT_DATA=$(curl -sS -LD "$HEADERS" -X GET "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/next")
  echo "Event data: $EVENT_DATA"

  # Extract request ID from response headers
  REQUEST_ID=$(grep -Fi Lambda-Runtime-Aws-Request-Id "$HEADERS" | tr -d '[:space:]' | cut -d: -f2)
  echo "Request ID: $REQUEST_ID"

  # Execute the Java Lambda handler
  # The handler will process the event and return a response
  RESPONSE=$(java -cp "$HANDLER_CLASSPATH" \
    -Dcom.amazonaws.lambda.java.Handlers="com.lambda.HelloWorldHandler" \
    com.amazonaws.lambda.runtime.api.client.LambdaRuntime 2>&1 || echo '{"error": "Handler execution failed"}')
  
  # Fallback: if special handler execution fails, use a simple response
  if [ -z "$RESPONSE" ] || [ "$RESPONSE" = "Handler execution failed" ]; then
    RESPONSE='{"message": "Hello World from Java 21!"}'
  fi

  # Format as API Gateway response if needed
  JSON_RESPONSE="{
    \"isBase64Encoded\": false,
    \"statusCode\": 200,
    \"body\": \"$RESPONSE\"
  }"

  # Send the response back to Lambda Runtime API
  curl -X POST "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/$REQUEST_ID/response" \
    -d "${JSON_RESPONSE}"
done
